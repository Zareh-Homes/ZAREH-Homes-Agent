# Production: every value comes from the deployment's secret store. Never commit real values.
# `node scripts/check-config.ts` refuses to start the container if any of these is unsafe.
NODE_ENV=production
DATABASE_URL=postgresql://zareh_app_login:<from secret store>@<db host>:5432/zareh?sslmode=verify-full
APP_ORIGINS=https://backoffice.example.ca
COOKIE_SECURE=true
FIELD_ENCRYPTION_KEY=<32 random bytes, base64: openssl rand -base64 32>
FILE_ENCRYPTION_KEY=<a different 32 random bytes, base64>
UPLOAD_DIR=/var/lib/zareh/uploads
TRUST_PROXY=true
# Printed on every CDA (no defaults)
BROKERAGE_LEGAL_NAME=
BROKERAGE_ADDRESS=
BROKERAGE_PHONE=
BROKERAGE_EMAIL=
BROKERAGE_HST_NUMBER=
BROKERAGE_RECO_REGISTRATION=
BROKER_OF_RECORD=
# From the accountant: account role -> chart of accounts code
ACCOUNTING_ACCOUNT_MAP={}
# Never set in production: ALLOW_DEV_AUTH_HEADER, ACCOUNTING_PROVIDER

# Outgoing email (renewal reminders). Without both, emails wait in Admin → Emails & reminders.
# SMTP_URL holds the mail account password: keep it in the secret store, e.g. smtps://user:password@smtp.example.com:465
SMTP_URL=
EMAIL_FROM=Zareh Homes <office@zarehhomes.ca>

# Breached-password screening (on by default in production; "required" refuses passwords while the service is down).
# The network must allow api.pwnedpasswords.com.
BREACHED_PASSWORD_CHECK=on
