// Zareh Homes – internal brokerage back office (Lone Wolf / SkySlope replacement)
// PostgreSQL. Money is Decimal(12,2). Ontario context: RECO trust rules, TRESA, FINTRAC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGING_BROKER // Broker of Record – signs trust receipts, approves disbursements
  COMPLIANCE_ADMIN // Deal admin – reviews documents and FINTRAC records
  AGENT
}

enum ListingStatus {
  ACTIVE
  PENDING // conditional / firm, not yet closed
  CLOSED
  CANCELLED
  EXPIRED
}

enum PropertyType {
  DETACHED
  SEMI_DETACHED
  TOWNHOUSE
  CONDO_APARTMENT
  CONDO_TOWNHOUSE
  PRE_CONSTRUCTION
  MULTIPLEX
  COMMERCIAL
  LAND
  OTHER
}

enum DealSide {
  LISTING // seller side
  BUYER
  DUAL // both sides, same brokerage
  LANDLORD
  TENANT
}

enum DealStatus {
  CONDITIONAL
  FIRM
  CLOSED
  COLLAPSED
  CANCELLED
}

enum DepositStatus {
  NOT_DUE
  AWAITING // due, not received
  RECEIVED // in our trust account
  HELD_ELSEWHERE // held by co-op brokerage, lawyer or builder
  RELEASED // disbursed at closing
  REFUNDED // returned (collapsed deal, mutual release)
}

// Who legally holds the buyer's deposit in trust (TRESA / RECO)
enum DepositHolder {
  OUR_BROKERAGE
  COOP_BROKERAGE
  LAWYER
  BUILDER // pre-construction: held by builder's lawyer / trustee under the Condo Act
}

enum DealAgentRole {
  PRIMARY
  CO_AGENT
  REFERRAL
}

enum PartyRole {
  SELLER
  BUYER
  LANDLORD
  TENANT
  SELLER_LAWYER
  BUYER_LAWYER
  COOP_BROKERAGE
}

enum TrustEntryType {
  DEPOSIT_RECEIVED
  DISBURSEMENT_TO_GENERAL // commission earned, moved to general account on close
  DISBURSEMENT_TO_COOP
  DISBURSEMENT_TO_LAWYER
  REFUND_TO_PAYER
  REVERSAL // corrects a prior entry; entries are never edited or deleted
}

// What legally authorizes money to leave trust
enum TrustAuthorization {
  CLOSING_COMPLETED // deal closed per the APS
  MUTUAL_RELEASE // signed mutual release (terminated deal)
  COURT_ORDER
}

enum TrustHoldReason {
  DISPUTED // deal fell through, no mutual release
  UNCLAIMED
}

enum PaymentMethod {
  CHEQUE
  CERTIFIED_CHEQUE
  BANK_DRAFT
  EFT
  WIRE
}

// Missing -> Pending Review -> Approved | Needs Revision (-> Pending Review again).
// Transitions are enforced by a trigger (migrations/004_document_compliance.sql).
enum DocumentStatus {
  MISSING // slot exists, nothing uploaded
  PENDING_REVIEW // uploaded, awaiting broker / compliance review
  APPROVED
  NEEDS_REVISION // reviewer sent it back with a comment
  WAIVED // not applicable to this deal, waived by a reviewer
}

// What a slot is created for when a deal is opened
enum DocumentSlotScope {
  DEAL // one per deal (APS, Form 320, Form 200)
  CLIENT_INDIVIDUAL // one per individual client (FINTRAC ID record)
  CLIENT_CORPORATION // one per corporate client (FINTRAC corporate / beneficial ownership)
}

// Structured data an upload must carry
enum DocumentMetadataKind {
  NONE
  FINTRAC_INDIVIDUAL
  FINTRAC_CORPORATE
}

enum PartyEntityType {
  INDIVIDUAL
  CORPORATION
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
}

// ─────────────────────────────────────────────
// 1. Users & roles
// ─────────────────────────────────────────────

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  firstName          String
  lastName           String
  phone              String?
  role               UserRole @default(AGENT)
  recoRegistrationNo String?  @unique
  isPrec             Boolean  @default(false) // paid through a Personal Real Estate Corporation
  precLegalName      String?  @db.VarChar(200) // required when isPrec (DB check)
  hstNumber          String?  @db.VarChar(15) // CRA BN + RT account, e.g. 123456789RT0001
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listings           Listing[]             @relation("ListingAgent")
  dealAgents         TransactionAgent[]
  reviewedDocuments  DocumentSlot[]        @relation("Reviewer")
  uploadedFiles      DocumentFile[]
  documentReviews    DocumentReview[]      @relation("DocumentReviewer")
  notifications      Notification[]
  commissionPlan     CommissionPlan?
  closingsFinalized  ClosingStatement[]    @relation("ClosingFinalizedBy")
  closingPayouts     ClosingAgentPayout[]
  trustEntriesMade   TrustLedgerEntry[]    @relation("EnteredBy")
  trustEntriesSigned TrustLedgerEntry[]    @relation("AuthorizedBy")
  trustHoldsFlagged  TrustHold[]           @relation("HoldFlaggedBy")
  trustHoldsReleased TrustHold[]           @relation("HoldReleasedBy")
  reconciliations    TrustReconciliation[]
  auditLogs          AuditLog[]

  @@index([role, isActive])
}

// ─────────────────────────────────────────────
// 2. Listings
// ─────────────────────────────────────────────

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  mlsNumber      String?       @unique // null until posted (e.g. exclusive)
  streetAddress  String
  unit           String?
  city           String
  province       String        @default("ON")
  postalCode     String?
  propertyType   PropertyType
  listPrice      Decimal       @db.Decimal(12, 2)
  status         ListingStatus @default(ACTIVE)
  listingDate    DateTime      @db.Date
  expiryDate     DateTime?     @db.Date
  listingAgentId String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listingAgent  User           @relation("ListingAgent", fields: [listingAgentId], references: [id])
  transactions  Transaction[]
  documentSlots DocumentSlot[]

  @@index([status])
  @@index([listingAgentId, status])
  @@index([city])
  @@index([listingDate])
}

// ─────────────────────────────────────────────
// 3. Transactions (deals)
// ─────────────────────────────────────────────

model Transaction {
  id            String     @id @default(uuid()) @db.Uuid
  dealNumber    String     @unique // e.g. 2026-0142, used on the trade record sheet
  side          DealSide
  status        DealStatus @default(CONDITIONAL)
  listingId     String?    @db.Uuid // set when it's one of our listings
  streetAddress String // copied so buy-side deals need no Listing row
  unit          String?
  city          String
  mlsNumber     String?

  salePrice         Decimal   @db.Decimal(12, 2)
  offerDate         DateTime  @db.Date
  conditionsDueDate DateTime? @db.Date
  firmDate          DateTime? @db.Date
  closeDate         DateTime  @db.Date

  depositAmount      Decimal       @db.Decimal(12, 2)
  depositDueDate     DateTime?     @db.Date
  trustDepositHolder DepositHolder
  depositStatus      DepositStatus @default(AWAITING)

  totalGci             Decimal  @db.Decimal(12, 2) // gross commission to our brokerage, pre-split, excl. HST
  hstOnGci             Decimal  @default(0) @db.Decimal(12, 2) // 13% Ontario HST collected on totalGci
  commissionRatePct    Decimal? @db.Decimal(5, 3)
  coopBrokerageName    String?
  coopAgentName        String?
  // Listing side: the co-operating brokerage's commission (base, excl. HST), paid out of the
  // total the seller owes us. Zero on buyer-side and dual deals.
  coopCommission       Decimal  @default(0) @db.Decimal(12, 2)
  outsideReferralPayee String?
  outsideReferralPct   Decimal? @db.Decimal(5, 2) // % of base GCI owed to an outside referring brokerage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing       Listing?           @relation(fields: [listingId], references: [id])
  agents        TransactionAgent[]
  parties       TransactionParty[]
  trustEntries  TrustLedgerEntry[]
  trustHolds    TrustHold[]
  closing       ClosingStatement?
  documentSlots DocumentSlot[]

  @@index([status])
  @@index([closeDate])
  @@index([listingId])
  @@index([depositStatus, depositDueDate])
}

// Agent split per deal (supports co-listing, teams, referrals)
model TransactionAgent {
  id            String        @id @default(uuid()) @db.Uuid
  transactionId String        @db.Uuid
  userId        String        @db.Uuid
  role          DealAgentRole @default(PRIMARY)
  splitPct      Decimal       @db.Decimal(5, 2) // agent's split on this deal, e.g. 80 = 80/20
  gciSharePct   Decimal       @default(100) @db.Decimal(5, 2) // share of the deal's GCI (co-listings); sums to 100
  grossShare    Decimal       @db.Decimal(12, 2)
  brokerageFee  Decimal       @default(0) @db.Decimal(12, 2)
  netPayout     Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
  @@index([userId])
}

// Buyers, sellers, lawyers – also drives FINTRAC ID records
model TransactionParty {
  id                  String          @id @default(uuid()) @db.Uuid
  transactionId       String          @db.Uuid
  role                PartyRole
  entityType          PartyEntityType @default(INDIVIDUAL)
  fullName            String
  email               String?
  phone               String?
  fintracIdVerifiedAt DateTime?
  fintracIdMethod     String? // e.g. "Government photo ID", "Dual process"

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  documentSlots DocumentSlot[]

  @@index([transactionId, role])
}

// ─────────────────────────────────────────────
// 4. Trust / escrow ledger (append-only)
// ─────────────────────────────────────────────

model TrustAccount {
  id           String   @id @default(uuid()) @db.Uuid
  name         String // e.g. "Real Estate Trust – TD"
  bankName     String
  accountLast4 String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  entries         TrustLedgerEntry[]
  reconciliations TrustReconciliation[]
}

// Append-only. The database rejects every UPDATE, DELETE and TRUNCATE
// (migrations/003_trust_ledger_invariants.sql); corrections are REVERSAL rows.
model TrustLedgerEntry {
  id                     String              @id @default(uuid()) @db.Uuid
  trustAccountId         String              @db.Uuid
  transactionId          String              @db.Uuid
  entryType              TrustEntryType
  direction              Int                 @default(0) @db.SmallInt // +1 in / −1 out, set by DB trigger
  amount                 Decimal             @db.Decimal(12, 2) // always positive
  method                 PaymentMethod
  referenceNo            String? // bank reference / cheque # / wire trace
  receiptNumber          Int?                @unique // sequential trust receipt # (deposits only)
  counterparty           String // payor on deposits, payee on disbursements
  receivedDate           DateTime?           @db.Date // deposits: date funds received by brokerage
  effectiveDate          DateTime            @db.Date // date funds hit / left the trust account
  authorizationMethod    TrustAuthorization? // disbursements only
  authorizationReference String? // release / court order reference
  memo                   String? // required on reversals (reason)
  reversesEntryId        String?             @unique @db.Uuid
  idempotencyKey         String              @unique @db.Uuid
  enteredById            String              @db.Uuid
  authorizedById         String              @db.Uuid // Broker of Record who authorized it
  createdAt              DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  trustAccount TrustAccount      @relation(fields: [trustAccountId], references: [id])
  transaction  Transaction       @relation(fields: [transactionId], references: [id])
  reverses     TrustLedgerEntry? @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy   TrustLedgerEntry? @relation("Reversal")
  enteredBy    User              @relation("EnteredBy", fields: [enteredById], references: [id])
  authorizedBy User              @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  holds        TrustHold[]

  @@index([transactionId, trustAccountId, createdAt])
  @@index([trustAccountId, effectiveDate])
}

// Blocks every disbursement on a deal while active. Rows are never deleted;
// the only allowed update is a one-time release.
model TrustHold {
  id             String          @id @default(uuid()) @db.Uuid
  transactionId  String          @db.Uuid
  depositEntryId String?         @db.Uuid
  reason         TrustHoldReason
  note           String
  flaggedById    String          @db.Uuid
  flaggedAt      DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  releasedById   String?         @db.Uuid
  releasedAt     DateTime?       @db.Timestamptz(6)
  releaseNote    String?

  transaction  Transaction       @relation(fields: [transactionId], references: [id])
  depositEntry TrustLedgerEntry? @relation(fields: [depositEntryId], references: [id])
  flaggedBy    User              @relation("HoldFlaggedBy", fields: [flaggedById], references: [id])
  releasedBy   User?             @relation("HoldReleasedBy", fields: [releasedById], references: [id])

  @@index([transactionId])
}

model TrustReconciliation {
  id               String   @id @default(uuid()) @db.Uuid
  trustAccountId   String   @db.Uuid
  periodEnd        DateTime @db.Date
  bankBalance      Decimal  @db.Decimal(12, 2)
  ledgerBalance    Decimal  @db.Decimal(12, 2)
  outstandingItems Decimal  @default(0) @db.Decimal(12, 2)
  isBalanced       Boolean
  completedById    String   @db.Uuid
  completedAt      DateTime @default(now())
  notes            String?

  trustAccount TrustAccount @relation(fields: [trustAccountId], references: [id])
  completedBy  User         @relation(fields: [completedById], references: [id])

  @@unique([trustAccountId, periodEnd])
}

// ─────────────────────────────────────────────
// 5. Document checklist
// ─────────────────────────────────────────────

// Master list, e.g. "Listing Agreement (Form 271)", "APS (Form 100)", "FINTRAC ID", "Deposit receipt"
model DocumentType {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique // stable key used by code: APS, FORM_320, FINTRAC_INDIVIDUAL …
  name         String               @unique
  formNumber   String? // OREA form #
  requiredFor  DealSide[] // sides that get this slot automatically
  slotScope    DocumentSlotScope    @default(DEAL)
  metadataKind DocumentMetadataKind @default(NONE)
  forListing   Boolean              @default(false) // auto-added to new listings
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)

  slots DocumentSlot[]
}

// One required document on one listing or deal
// One required document on one listing or deal. FINTRAC slots also point at
// the client party they are for. Uniqueness per (deal, type[, party]) is a
// pair of partial indexes in migration 004.
model DocumentSlot {
  id             String         @id @default(uuid()) @db.Uuid
  documentTypeId String         @db.Uuid
  listingId      String?        @db.Uuid
  transactionId  String?        @db.Uuid
  partyId        String?        @db.Uuid
  status         DocumentStatus @default(MISSING)
  isRequired     Boolean        @default(true)
  dueDate        DateTime?      @db.Date
  reviewerId     String?        @db.Uuid
  reviewedAt     DateTime?      @db.Timestamptz(6)
  reviewComment  String? // required when NEEDS_REVISION
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  documentType DocumentType      @relation(fields: [documentTypeId], references: [id])
  listing      Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  transaction  Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  party        TransactionParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  reviewer     User?             @relation("Reviewer", fields: [reviewerId], references: [id])
  files        DocumentFile[]
  reviews      DocumentReview[]

  @@unique([listingId, documentTypeId])
  @@index([transactionId])
  @@index([status])
  @@index([reviewerId, status])
}

// Every upload is kept; latest version is what gets reviewed
// Every upload is kept (append-only); the highest version is the one under review.
model DocumentFile {
  id           String               @id @default(uuid()) @db.Uuid
  slotId       String               @db.Uuid
  version      Int
  fileName     String
  storageKey   String // S3 / Drive path
  mimeType     String
  sizeBytes    Int
  sha256       String
  metadataKind DocumentMetadataKind @default(NONE)
  metadata     Json? // validated FINTRAC record fields, by metadataKind
  uploadedById String               @db.Uuid
  uploadedAt   DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  slot       DocumentSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  uploadedBy User             @relation(fields: [uploadedById], references: [id])
  reviews    DocumentReview[]

  @@unique([slotId, version])
}

// Append-only history of every review decision
model DocumentReview {
  id         String         @id @default(uuid()) @db.Uuid
  slotId     String         @db.Uuid
  fileId     String         @db.Uuid // the exact version that was reviewed
  decision   ReviewDecision
  comment    String?
  reviewerId String         @db.Uuid
  createdAt  DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  slot     DocumentSlot @relation(fields: [slotId], references: [id])
  file     DocumentFile @relation(fields: [fileId], references: [id])
  reviewer User         @relation("DocumentReviewer", fields: [reviewerId], references: [id])

  @@index([slotId, createdAt])
}

// In-app notifications (pushed live over SSE, kept for when the user is offline)
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  type          String // DOCUMENT_NEEDS_REVISION, DOCUMENT_APPROVED
  title         String
  body          String
  transactionId String?   @db.Uuid
  slotId        String?   @db.Uuid
  createdAt     DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  readAt        DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

// ─────────────────────────────────────────────
// Audit trail (RECO inspections)
// ─────────────────────────────────────────────

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @db.Uuid
  entity    String // "Transaction", "TrustLedgerEntry", ...
  entityId  String
  action    String // CREATE / UPDATE / APPROVE / REJECT ...
  changes   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Commission plans and closing (CDA)
// ─────────────────────────────────────────────

// An agent's standing plan. The split itself is per deal (TransactionAgent.splitPct);
// the plan supplies the annual cap and the fees charged on every deal.
model CommissionPlan {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  annualCap         Decimal? @db.Decimal(12, 2) // most the house collects per cap year; null = no cap
  capYearStartMonth Int      @default(1)
  capYearStartDay   Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User                @relation(fields: [userId], references: [id])
  fees CommissionPlanFee[]
}

// Charged to the agent on each deal, plus 13% HST (deal fee, desk fee, E&O …)
model CommissionPlanFee {
  id     String  @id @default(uuid()) @db.Uuid
  planId String  @db.Uuid
  name   String
  amount Decimal @db.Decimal(12, 2)

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// The finalized closing for a deal: frozen numbers plus the exact CDA documents
// that were issued. Append-only (migration 005).
model ClosingStatement {
  id             String   @id @default(uuid()) @db.Uuid
  transactionId  String   @unique @db.Uuid
  cdaNumber      String   @unique
  computation    Json // full calculation, as issued
  computationSha String // SHA-256 of the computation JSON
  lawyerHtml     String // CDA sent to the closing lawyer
  internalHtml   String // same, plus the agent commission statements
  idempotencyKey String   @unique @db.Uuid
  finalizedById  String   @db.Uuid
  finalizedAt    DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  transaction Transaction          @relation(fields: [transactionId], references: [id])
  finalizedBy User                 @relation("ClosingFinalizedBy", fields: [finalizedById], references: [id])
  payouts     ClosingAgentPayout[]
}

// One row per agent per finalized closing; also the source of cap year-to-date totals.
model ClosingAgentPayout {
  id               String   @id @default(uuid()) @db.Uuid
  closingId        String   @db.Uuid
  userId           String   @db.Uuid
  closeDate        DateTime @db.Date
  payeeName        String
  allocatedBaseGci Decimal  @db.Decimal(12, 2)
  houseSplitBase   Decimal  @db.Decimal(12, 2) // counts toward the agent's cap
  agentSplitBase   Decimal  @db.Decimal(12, 2)
  agentSplitHst    Decimal  @db.Decimal(12, 2)
  feesBase         Decimal  @db.Decimal(12, 2)
  feesHst          Decimal  @db.Decimal(12, 2)
  netPayout        Decimal  @db.Decimal(12, 2)
  wiredByLawyer    Decimal  @db.Decimal(12, 2) // part of the payout wired directly
  paidByBrokerage  Decimal  @db.Decimal(12, 2) // part paid by the brokerage from funds it received

  closing ClosingStatement @relation(fields: [closingId], references: [id])
  user    User             @relation(fields: [userId], references: [id])

  @@index([userId, closeDate])
}
