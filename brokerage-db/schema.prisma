// Zareh Homes – internal brokerage back office (Lone Wolf / SkySlope replacement)
// PostgreSQL. Money is Decimal(12,2). Ontario context: RECO trust rules, TRESA, FINTRAC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum UserRole {
  ADMIN
  MANAGING_BROKER // Broker of Record – signs trust receipts, approves disbursements
  COMPLIANCE_ADMIN // Deal admin – reviews documents and FINTRAC records
  AGENT
}

enum ListingStatus {
  ACTIVE
  PENDING // conditional / firm, not yet closed
  CLOSED
  CANCELLED
  EXPIRED
}

enum PropertyType {
  DETACHED
  SEMI_DETACHED
  TOWNHOUSE
  CONDO_APARTMENT
  CONDO_TOWNHOUSE
  PRE_CONSTRUCTION
  MULTIPLEX
  COMMERCIAL
  LAND
  OTHER
}

enum DealSide {
  LISTING // seller side
  BUYER
  DUAL // both sides, same brokerage
  LANDLORD
  TENANT
}

enum DealStatus {
  CONDITIONAL
  FIRM
  CLOSED
  COLLAPSED
  CANCELLED
}

enum DepositStatus {
  NOT_DUE
  AWAITING // due, not received
  RECEIVED // in our trust account
  HELD_ELSEWHERE // held by co-op brokerage, lawyer or builder
  RELEASED // disbursed at closing
  REFUNDED // returned (collapsed deal, mutual release)
}

// Who legally holds the buyer's deposit in trust (TRESA / RECO)
enum DepositHolder {
  OUR_BROKERAGE
  COOP_BROKERAGE
  LAWYER
  BUILDER // pre-construction: held by builder's lawyer / trustee under the Condo Act
}

enum DealAgentRole {
  PRIMARY
  CO_AGENT
  REFERRAL
}

enum PartyRole {
  SELLER
  BUYER
  LANDLORD
  TENANT
  SELLER_LAWYER
  BUYER_LAWYER
  COOP_BROKERAGE
}

enum TrustEntryType {
  DEPOSIT_RECEIVED
  DISBURSEMENT_TO_GENERAL // commission earned, moved to general account on close
  DISBURSEMENT_TO_COOP
  DISBURSEMENT_TO_LAWYER
  REFUND_TO_PAYER
  REVERSAL // corrects a prior entry; entries are never edited or deleted
}

// What legally authorizes money to leave trust
enum TrustAuthorization {
  CLOSING_COMPLETED // deal closed per the APS
  MUTUAL_RELEASE // signed mutual release (terminated deal)
  COURT_ORDER
}

enum TrustHoldReason {
  DISPUTED // deal fell through, no mutual release
  UNCLAIMED
}

enum PaymentMethod {
  CHEQUE
  CERTIFIED_CHEQUE
  BANK_DRAFT
  EFT
  WIRE
}

// Missing -> Pending Review -> Approved | Needs Revision (-> Pending Review again).
// Transitions are enforced by a trigger (migrations/004_document_compliance.sql).
enum DocumentStatus {
  MISSING // slot exists, nothing uploaded
  PENDING_REVIEW // uploaded, awaiting broker / compliance review
  APPROVED
  NEEDS_REVISION // reviewer sent it back with a comment
  WAIVED // not applicable to this deal, waived by a reviewer
}

// What a slot is created for when a deal is opened
enum DocumentSlotScope {
  DEAL // one per deal (APS, Form 320, Form 200)
  CLIENT_INDIVIDUAL // one per individual client (FINTRAC ID record)
  CLIENT_CORPORATION // one per corporate client (FINTRAC corporate / beneficial ownership)
}

// Structured data an upload must carry
enum DocumentMetadataKind {
  NONE
  FINTRAC_INDIVIDUAL
  FINTRAC_CORPORATE
}

enum PartyEntityType {
  INDIVIDUAL
  CORPORATION
}

enum ReviewDecision {
  APPROVED
  NEEDS_REVISION
}

// ─────────────────────────────────────────────
// 1. Users & roles
// ─────────────────────────────────────────────

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  firstName          String
  lastName           String
  phone              String?
  role               UserRole @default(AGENT)
  recoRegistrationNo String?  @unique
  isPrec             Boolean  @default(false) // paid through a Personal Real Estate Corporation
  precLegalName      String?  @db.VarChar(200) // required when isPrec (DB check)
  hstNumber          String?  @db.VarChar(15) // CRA BN + RT account, e.g. 123456789RT0001
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  listings                Listing[]                   @relation("ListingAgent")
  dealAgents              TransactionAgent[]
  reviewedDocuments       DocumentSlot[]              @relation("Reviewer")
  uploadedFiles           DocumentFile[]
  documentReviews         DocumentReview[]            @relation("DocumentReviewer")
  notifications           Notification[]
  commissionPlan          CommissionPlan?
  closingsFinalized       ClosingStatement[]          @relation("ClosingFinalizedBy")
  closingPayouts          ClosingAgentPayout[]
  commissionReceipts      CommissionReceipt[]
  credential              UserCredential?
  sessions                Session[]
  authTokens              AuthToken[]                 @relation("AuthTokenFor")
  authTokensIssued        AuthToken[]                 @relation("AuthTokenIssuedBy")
  legalHoldsPlaced        LegalHold[]                 @relation("LegalHoldPlacedBy")
  legalHoldsReleased      LegalHold[]                 @relation("LegalHoldReleasedBy")
  privacyBreaches         PrivacyBreach[]
  privacyBreachEvents     PrivacyBreachEvent[]
  proclaimedHolidays      ProclaimedHoliday[]
  unclaimedFundsOpened    UnclaimedTrustFund[]
  unclaimedFundEvents     UnclaimedFundEvent[]
  payoutEvents            PayoutEvent[]
  receiptReversals        CommissionReceiptReversal[]
  closingVoids            ClosingVoid[]
  statementVerifications  BankStatementVerification[]
  designations            BrokerOfRecordDesignation[] @relation("Designated")
  designationsRecorded    BrokerOfRecordDesignation[] @relation("DesignationRecordedBy")
  policyDecisions         FinancialPolicyDecision[]
  incidentsDetected       TrustIncident[]
  incidentEvents          TrustIncidentEvent[]
  trustEntriesMade        TrustLedgerEntry[]          @relation("EnteredBy")
  trustEntriesSigned      TrustLedgerEntry[]          @relation("AuthorizedBy")
  trustHoldsFlagged       TrustHold[]                 @relation("HoldFlaggedBy")
  trustHoldsReleased      TrustHold[]                 @relation("HoldReleasedBy")
  reconciliationsPrepared TrustReconciliation[]       @relation("ReconciliationPreparedBy")
  reconciliationsSigned   TrustReconciliation[]       @relation("ReconciliationSignedBy")
  bankStatements          BankStatement[]
  bankMatches             BankMatch[]
  auditLogs               AuditLog[]

  @@index([role, isActive])
}

// ─────────────────────────────────────────────
// 2. Listings
// ─────────────────────────────────────────────

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  mlsNumber      String?       @unique // null until posted (e.g. exclusive)
  streetAddress  String
  unit           String?
  city           String
  province       String        @default("ON")
  postalCode     String?
  propertyType   PropertyType
  listPrice      Decimal       @db.Decimal(12, 2)
  status         ListingStatus @default(ACTIVE)
  listingDate    DateTime      @db.Date
  expiryDate     DateTime?     @db.Date
  listingAgentId String        @db.Uuid
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  listingAgent  User           @relation("ListingAgent", fields: [listingAgentId], references: [id])
  transactions  Transaction[]
  documentSlots DocumentSlot[]

  @@index([status])
  @@index([listingAgentId, status])
  @@index([city])
  @@index([listingDate])
}

// ─────────────────────────────────────────────
// 3. Transactions (deals)
// ─────────────────────────────────────────────

model Transaction {
  id            String     @id @default(uuid()) @db.Uuid
  dealNumber    String     @unique // e.g. 2026-0142, used on the trade record sheet
  side          DealSide
  status        DealStatus @default(CONDITIONAL)
  listingId     String?    @db.Uuid // set when it's one of our listings
  streetAddress String // copied so buy-side deals need no Listing row
  unit          String?
  city          String
  mlsNumber     String?

  salePrice         Decimal   @db.Decimal(12, 2)
  offerDate         DateTime  @db.Date
  conditionsDueDate DateTime? @db.Date
  firmDate          DateTime? @db.Date
  closeDate         DateTime  @db.Date

  depositAmount      Decimal       @db.Decimal(12, 2)
  depositDueDate     DateTime?     @db.Date
  trustDepositHolder DepositHolder
  depositStatus      DepositStatus @default(AWAITING)

  totalGci             Decimal         @db.Decimal(12, 2) // gross commission to our brokerage, pre-split, excl. HST
  hstOnGci             Decimal?        @default(0) @db.Decimal(12, 2) // 13% Ontario HST collected on totalGci; NULL only when hstSource is MISSING
  hstSource            TaxAmountSource @default(CALCULATED) // migration 007
  commissionRatePct    Decimal?        @db.Decimal(5, 3)
  coopBrokerageName    String?
  coopAgentName        String?
  // Listing side: the co-operating brokerage's commission (base, excl. HST), paid out of the
  // total the seller owes us. Zero on buyer-side and dual deals.
  coopCommission       Decimal         @default(0) @db.Decimal(12, 2)
  outsideReferralPayee String?
  outsideReferralPct   Decimal?        @db.Decimal(5, 2) // % of base GCI owed to an outside referring brokerage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  listing        Listing?             @relation(fields: [listingId], references: [id])
  agents         TransactionAgent[]
  parties        TransactionParty[]
  trustEntries   TrustLedgerEntry[]
  trustHolds     TrustHold[]
  closings       ClosingStatement[]
  legalHolds     LegalHold[]
  unclaimedFunds UnclaimedTrustFund[]
  documentSlots  DocumentSlot[]

  @@index([status])
  @@index([closeDate])
  @@index([listingId])
  @@index([depositStatus, depositDueDate])
}

// Agent split per deal (supports co-listing, teams, referrals)
model TransactionAgent {
  id            String        @id @default(uuid()) @db.Uuid
  transactionId String        @db.Uuid
  userId        String        @db.Uuid
  role          DealAgentRole @default(PRIMARY)
  splitPct      Decimal       @db.Decimal(5, 2) // agent's split on this deal, e.g. 80 = 80/20
  gciSharePct   Decimal       @default(100) @db.Decimal(5, 2) // share of the deal's GCI (co-listings); sums to 100
  grossShare    Decimal       @db.Decimal(12, 2)
  brokerageFee  Decimal       @default(0) @db.Decimal(12, 2)
  netPayout     Decimal       @db.Decimal(12, 2)
  paidAt        DateTime?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id])

  @@unique([transactionId, userId])
  @@index([userId])
}

// Buyers, sellers, lawyers – also drives FINTRAC ID records
model TransactionParty {
  id                  String          @id @default(uuid()) @db.Uuid
  transactionId       String          @db.Uuid
  role                PartyRole
  entityType          PartyEntityType @default(INDIVIDUAL)
  fullName            String
  email               String?
  phone               String?
  fintracIdVerifiedAt DateTime?
  fintracIdMethod     String? // e.g. "Government photo ID", "Dual process"

  transaction   Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  documentSlots DocumentSlot[]

  @@index([transactionId, role])
}

// ─────────────────────────────────────────────
// 4. Trust / escrow ledger (append-only)
// ─────────────────────────────────────────────

model TrustAccount {
  id           String           @id @default(uuid()) @db.Uuid
  name         String // e.g. "Real Estate Trust – TD"
  bankName     String
  accountLast4 String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  kind         TrustAccountKind @default(REAL_ESTATE_TRUST) // migration 009

  entries            TrustLedgerEntry[]
  reconciliations    TrustReconciliation[]
  bankStatements     BankStatement[]
  commissionReceipts CommissionReceipt[]
  payoutEventsFrom   PayoutEvent[]
  incidents          TrustIncident[]
  unclaimedFunds     UnclaimedTrustFund[]
}

enum TrustAccountKind {
  REAL_ESTATE_TRUST
  COMMISSION_TRUST
}

// Append-only. The database rejects every UPDATE, DELETE and TRUNCATE
// (migrations/003_trust_ledger_invariants.sql); corrections are REVERSAL rows.
model TrustLedgerEntry {
  id                     String              @id @default(uuid()) @db.Uuid
  trustAccountId         String              @db.Uuid
  transactionId          String              @db.Uuid
  entryType              TrustEntryType
  direction              Int                 @default(0) @db.SmallInt // +1 in / −1 out, set by DB trigger
  amount                 Decimal             @db.Decimal(12, 2) // always positive
  method                 PaymentMethod
  referenceNo            String? // bank reference / cheque # / wire trace
  receiptNumber          Int?                @unique // sequential trust receipt # (deposits only)
  counterparty           String // payor on deposits, payee on disbursements
  receivedDate           DateTime?           @db.Date // deposits: date funds received by brokerage
  effectiveDate          DateTime            @db.Date // date funds hit / left the trust account
  authorizationMethod    TrustAuthorization? // disbursements only
  authorizationReference String? // release / court order reference
  memo                   String? // required on reversals (reason)
  reversesEntryId        String?             @unique @db.Uuid
  idempotencyKey         String              @unique @db.Uuid
  enteredById            String              @db.Uuid
  authorizedById         String              @db.Uuid // Broker of Record who authorized it
  createdAt              DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  trustAccount TrustAccount      @relation(fields: [trustAccountId], references: [id])
  transaction  Transaction       @relation(fields: [transactionId], references: [id])
  reverses     TrustLedgerEntry? @relation("Reversal", fields: [reversesEntryId], references: [id])
  reversedBy   TrustLedgerEntry? @relation("Reversal")
  bankMatches  BankMatch[]
  enteredBy    User              @relation("EnteredBy", fields: [enteredById], references: [id])
  authorizedBy User              @relation("AuthorizedBy", fields: [authorizedById], references: [id])
  holds        TrustHold[]

  @@index([transactionId, trustAccountId, createdAt])
  @@index([trustAccountId, effectiveDate])
}

// Blocks every disbursement on a deal while active. Rows are never deleted;
// the only allowed update is a one-time release.
model TrustHold {
  id             String          @id @default(uuid()) @db.Uuid
  transactionId  String          @db.Uuid
  depositEntryId String?         @db.Uuid
  reason         TrustHoldReason
  note           String
  flaggedById    String          @db.Uuid
  flaggedAt      DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  releasedById   String?         @db.Uuid
  releasedAt     DateTime?       @db.Timestamptz(6)
  releaseNote    String?

  transaction  Transaction       @relation(fields: [transactionId], references: [id])
  depositEntry TrustLedgerEntry? @relation(fields: [depositEntryId], references: [id])
  flaggedBy    User              @relation("HoldFlaggedBy", fields: [flaggedById], references: [id])
  releasedBy   User?             @relation("HoldReleasedBy", fields: [releasedById], references: [id])

  @@index([transactionId])
}

// Monthly trust reconciliation (O. Reg. 579/05 s.13): bank balance adjusted for
// outstanding items vs. the ledger vs. what's owed to each deal. Prepared by
// admin, signed by a managing broker, frozen once signed (migration 008).
model TrustReconciliation {
  id                       String    @id @default(uuid()) @db.Uuid
  trustAccountId           String    @db.Uuid
  statementId              String    @db.Uuid
  periodEnd                DateTime  @db.Date
  bankClosingBalance       Decimal   @db.Decimal(14, 2)
  outstandingDeposits      Decimal   @db.Decimal(14, 2) // in the ledger, not yet at the bank
  outstandingDisbursements Decimal   @db.Decimal(14, 2) // paid in the ledger, not yet cleared the bank
  unrecordedBankItems      Decimal   @db.Decimal(14, 2) // at the bank, not in the ledger (fees, returned items)
  adjustedBankBalance      Decimal   @db.Decimal(14, 2)
  ledgerBalance            Decimal   @db.Decimal(14, 2)
  clientLiabilities        Decimal   @db.Decimal(14, 2) // sum of every deal's trust balance
  difference               Decimal   @db.Decimal(14, 2)
  isBalanced               Boolean
  details                  Json // per-deal balances and every outstanding / unrecorded item
  explanation              String?
  preparedById             String    @db.Uuid
  preparedAt               DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  signedById               String?   @db.Uuid
  signedAt                 DateTime? @db.Timestamptz(6)
  signatureNote            String?
  signSegregationException Boolean   @default(false)
  signExceptionReason      String?
  supersedesId             String?   @unique @db.Uuid // migration 012: a correction of this signed reconciliation
  amendmentReason          String?

  trustAccount   TrustAccount         @relation(fields: [trustAccountId], references: [id])
  statement      BankStatement        @relation(fields: [statementId], references: [id])
  supersedes     TrustReconciliation? @relation("ReconciliationAmendment", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy   TrustReconciliation? @relation("ReconciliationAmendment")
  preparedBy     User                 @relation("ReconciliationPreparedBy", fields: [preparedById], references: [id])
  signedBy       User?                @relation("ReconciliationSignedBy", fields: [signedById], references: [id], onDelete: Restrict)
  incidents      TrustIncident[]
  incidentEvents TrustIncidentEvent[]

  @@index([trustAccountId, periodEnd])
}

// The brokerage's general (operating) account, where commission is received.
model OperatingAccount {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  bankName     String
  accountLast4 String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  bankStatements     BankStatement[]
  commissionReceipts CommissionReceipt[]
  payoutEventsFrom   PayoutEvent[]
}

// A monthly bank statement imported from CSV. Consecutive, balanced, append-only (migration 008).
model BankStatement {
  id                  String        @id @default(uuid()) @db.Uuid
  trustAccountId      String?       @db.Uuid
  operatingAccountId  String?       @db.Uuid
  periodStart         DateTime      @db.Date
  periodEnd           DateTime      @db.Date
  openingBalance      Decimal?      @db.Decimal(14, 2) // required for MONTHLY
  closingBalance      Decimal       @db.Decimal(14, 2) // for INTERIM: the balance as of periodEnd
  fileName            String
  fileSha256          String
  importedById        String        @db.Uuid
  importedAt          DateTime      @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  kind                StatementKind @default(MONTHLY) // migration 009
  receivedDate        DateTime?     @db.Date // when the brokerage received it: starts the s.13 30-day clock
  source              String? // BANK_PORTAL_DOWNLOAD, BANK_EMAIL, BANK_PAPER_STATEMENT, OTHER
  sourceNote          String?
  integrityExceptions Json          @default("[]") // migration 012: differences from earlier interim records of the same account

  trustAccount     TrustAccount?              @relation(fields: [trustAccountId], references: [id], onDelete: Restrict)
  operatingAccount OperatingAccount?          @relation(fields: [operatingAccountId], references: [id], onDelete: Restrict)
  importedBy       User                       @relation(fields: [importedById], references: [id])
  lines            BankTransaction[]
  reconciliations  TrustReconciliation[]
  verification     BankStatementVerification?
  balanceFor       PayoutEvent[]

  @@index([trustAccountId, periodEnd])
  @@index([operatingAccountId, periodEnd])
}

model BankTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  statementId String   @db.Uuid
  lineNumber  Int
  postedDate  DateTime @db.Date
  amount      Decimal  @db.Decimal(14, 2) // + money in, − money out
  description String
  reference   String?
  fingerprint String?  @unique // duplicate detection across overlapping interim records

  statement      BankStatement        @relation(fields: [statementId], references: [id])
  match          BankMatch?
  incidentEvents TrustIncidentEvent[]

  @@unique([statementId, lineNumber])
}

enum ClearanceBasis {
  BANK_STATEMENT
  PRE_CUTOVER
}

// Proof a ledger entry or commission receipt went through the bank (migration 008).
model BankMatch {
  id                  String         @id @default(uuid()) @db.Uuid
  basis               ClearanceBasis
  bankTransactionId   String?        @unique @db.Uuid
  trustEntryId        String?        @db.Uuid
  commissionReceiptId String?        @db.Uuid
  payoutEventId       String?        @db.Uuid // migration 012: a payment or returned payment, confirmed at the bank
  receiptReversalId   String?        @db.Uuid // migration 012: a returned commission receipt
  note                String?
  matchedById         String         @db.Uuid
  matchedAt           DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  matchKind           StatementKind  @default(MONTHLY) // MONTHLY reconciles and clears; INTERIM clears until the statement arrives

  bankTransaction   BankTransaction?           @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  trustEntry        TrustLedgerEntry?          @relation(fields: [trustEntryId], references: [id], onDelete: Restrict)
  commissionReceipt CommissionReceipt?         @relation(fields: [commissionReceiptId], references: [id], onDelete: Restrict)
  matchedBy         User                       @relation(fields: [matchedById], references: [id])
  payoutEvent       PayoutEvent?               @relation(fields: [payoutEventId], references: [id], onDelete: Restrict)
  receiptReversal   CommissionReceiptReversal? @relation(fields: [receiptReversalId], references: [receiptId], onDelete: Restrict)

  @@unique([trustEntryId, matchKind])
  @@unique([commissionReceiptId, matchKind])
  @@unique([payoutEventId, matchKind])
  @@unique([receiptReversalId, matchKind])
}

enum StatementKind {
  MONTHLY
  INTERIM
}

// A second person checked the imported file against the bank itself (migration 009).
model BankStatementVerification {
  statementId          String   @id @db.Uuid
  verifiedById         String   @db.Uuid
  method               String // how it was checked, e.g. "Compared to TD EasyLine balance and activity"
  segregationException Boolean  @default(false)
  exceptionReason      String?
  verifiedAt           DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  exceptionsReviewed   String? // how each integrity exception was checked with the bank

  statement  BankStatement @relation(fields: [statementId], references: [id])
  verifiedBy User          @relation(fields: [verifiedById], references: [id])
}

enum BrokerDesignationRole {
  BROKER_OF_RECORD
  DESIGNATED_SUBSTITUTE
}

// Who legally acts as broker of record (or substitute), and when (migration 009).
model BrokerOfRecordDesignation {
  id            String                @id @default(uuid()) @db.Uuid
  userId        String                @db.Uuid
  role          BrokerDesignationRole
  effectiveFrom DateTime              @db.Date
  effectiveTo   DateTime?             @db.Date
  reference     String // e.g. RECO registration confirmation
  createdById   String                @db.Uuid
  createdAt     DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  user      User @relation("Designated", fields: [userId], references: [id])
  createdBy User @relation("DesignationRecordedBy", fields: [createdById], references: [id])

  @@index([userId])
}

// Switches for decisions that need counsel / accountant sign-off. Latest decision wins (migration 009).
model FinancialPolicyDecision {
  id          String   @id @default(uuid()) @db.Uuid
  policy      String // SOLE_OPERATOR_EXCEPTION, THIRD_PARTY_PAYABLES
  enabled     Boolean
  reference   String // the sign-off it rests on
  note        String?
  decidedById String   @db.Uuid
  decidedAt   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  decidedBy User @relation(fields: [decidedById], references: [id])

  @@index([policy, decidedAt])
}

enum TrustIncidentKind {
  SHORTFALL
  DISCREPANCY
}

enum TrustIncidentEventKind {
  OBSERVED
  NOTE
  REGISTRAR_NOTIFIED
  REPLENISHED
  RESOLVED
  CAUSE_DETERMINED // migration 012: BANK_SERVICE_FEE (Bulletin 8.2 exception) or OTHER
}

// A trust shortfall (O. Reg. 579/05 s.14) or other discrepancy and everything done about it (migration 009).
model TrustIncident {
  id               String            @id @default(uuid()) @db.Uuid
  trustAccountId   String            @db.Uuid
  kind             TrustIncidentKind
  summary          String
  amount           Decimal           @db.Decimal(14, 2)
  reconciliationId String?           @db.Uuid
  detectedById     String            @db.Uuid
  detectedAt       DateTime          @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  trustAccount   TrustAccount         @relation(fields: [trustAccountId], references: [id])
  reconciliation TrustReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  detectedBy     User                 @relation(fields: [detectedById], references: [id])
  events         TrustIncidentEvent[]

  @@index([trustAccountId, kind])
}

model TrustIncidentEvent {
  id                String                 @id @default(uuid()) @db.Uuid
  incidentId        String                 @db.Uuid
  kind              TrustIncidentEventKind
  eventDate         DateTime               @db.Date
  amount            Decimal?               @db.Decimal(14, 2)
  reference         String?
  note              String?
  reconciliationId  String?                @db.Uuid
  bankTransactionId String?                @db.Uuid
  actorId           String                 @db.Uuid
  createdAt         DateTime               @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  cause             String? // CAUSE_DETERMINED only: BANK_SERVICE_FEE or OTHER

  incident        TrustIncident        @relation(fields: [incidentId], references: [id])
  reconciliation  TrustReconciliation? @relation(fields: [reconciliationId], references: [id], onDelete: Restrict)
  bankTransaction BankTransaction?     @relation(fields: [bankTransactionId], references: [id], onDelete: Restrict)
  actor           User                 @relation(fields: [actorId], references: [id])

  @@index([incidentId, createdAt])
}

// ─────────────────────────────────────────────
// 5. Document checklist
// ─────────────────────────────────────────────

// Master list, e.g. "Listing Agreement (Form 271)", "APS (Form 100)", "FINTRAC ID", "Deposit receipt"
model DocumentType {
  id           String               @id @default(uuid()) @db.Uuid
  code         String               @unique // stable key used by code: APS, FORM_320, FINTRAC_INDIVIDUAL …
  name         String               @unique
  formNumber   String? // OREA form #
  requiredFor  DealSide[] // sides that get this slot automatically
  slotScope    DocumentSlotScope    @default(DEAL)
  metadataKind DocumentMetadataKind @default(NONE)
  forListing   Boolean              @default(false) // auto-added to new listings
  sortOrder    Int                  @default(0)
  isActive     Boolean              @default(true)

  slots DocumentSlot[]
}

// One required document on one listing or deal
// One required document on one listing or deal. FINTRAC slots also point at
// the client party they are for. Uniqueness per (deal, type[, party]) is a
// pair of partial indexes in migration 004.
model DocumentSlot {
  id             String         @id @default(uuid()) @db.Uuid
  documentTypeId String         @db.Uuid
  listingId      String?        @db.Uuid
  transactionId  String?        @db.Uuid
  partyId        String?        @db.Uuid
  status         DocumentStatus @default(MISSING)
  isRequired     Boolean        @default(true)
  dueDate        DateTime?      @db.Date
  reviewerId     String?        @db.Uuid
  reviewedAt     DateTime?      @db.Timestamptz(6)
  reviewComment  String? // required when NEEDS_REVISION
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  documentType DocumentType      @relation(fields: [documentTypeId], references: [id])
  listing      Listing?          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  transaction  Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  party        TransactionParty? @relation(fields: [partyId], references: [id], onDelete: Restrict)
  reviewer     User?             @relation("Reviewer", fields: [reviewerId], references: [id])
  files        DocumentFile[]
  reviews      DocumentReview[]

  @@unique([listingId, documentTypeId])
  @@index([transactionId])
  @@index([status])
  @@index([reviewerId, status])
}

// Every upload is kept; latest version is what gets reviewed
// Every upload is kept (append-only); the highest version is the one under review.
model DocumentFile {
  id           String               @id @default(uuid()) @db.Uuid
  slotId       String               @db.Uuid
  version      Int
  fileName     String
  storageKey   String // S3 / Drive path
  mimeType     String
  sizeBytes    Int
  sha256       String
  metadataKind DocumentMetadataKind @default(NONE)
  metadata     Json? // validated FINTRAC record fields, by metadataKind
  uploadedById String               @db.Uuid
  uploadedAt   DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  slot              DocumentSlot         @relation(fields: [slotId], references: [id], onDelete: Cascade)
  uploadedBy        User                 @relation(fields: [uploadedById], references: [id])
  reviews           DocumentReview[]
  unclaimedEvidence UnclaimedFundEvent[]

  @@unique([slotId, version])
}

// Append-only history of every review decision
model DocumentReview {
  id         String         @id @default(uuid()) @db.Uuid
  slotId     String         @db.Uuid
  fileId     String         @db.Uuid // the exact version that was reviewed
  decision   ReviewDecision
  comment    String?
  reviewerId String         @db.Uuid
  createdAt  DateTime       @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  slot     DocumentSlot @relation(fields: [slotId], references: [id])
  file     DocumentFile @relation(fields: [fileId], references: [id])
  reviewer User         @relation("DocumentReviewer", fields: [reviewerId], references: [id])

  @@index([slotId, createdAt])
}

// In-app notifications (pushed live over SSE, kept for when the user is offline)
model Notification {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  type          String // DOCUMENT_NEEDS_REVISION, DOCUMENT_APPROVED
  title         String
  body          String
  transactionId String?   @db.Uuid
  slotId        String?   @db.Uuid
  createdAt     DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  readAt        DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

// ─────────────────────────────────────────────
// Audit trail (RECO inspections)
// ─────────────────────────────────────────────

// Append-only security and activity trail (migration 010).
model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    String?  @db.Uuid
  entity    String // "Session", "Transaction", "DocumentFile", ...
  entityId  String
  action    String // LOGIN, LOGIN_FAILED, VIEW_SENSITIVE, EXPORT, APPROVE, POST /api/...
  changes   Json? // route params and safe details; never passwords, tokens or ID numbers
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  sessionId String?  @db.Uuid
  ip        String?
  userAgent String?
  outcome   String? // SUCCESS, DENIED, FAILED, ERROR
  route     String?

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

// Password, lockout and MFA state (migration 010). The MFA secret is encrypted by the application.
model UserCredential {
  userId             String    @id @db.Uuid
  passwordHash       String
  passwordChangedAt  DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz(6)
  mfaSecretEnc       String?
  mfaEnabledAt       DateTime? @db.Timestamptz(6)
  mfaLastStep        BigInt?
  recoveryCodeHashes String[]  @default([])

  user User @relation(fields: [userId], references: [id])
}

// Server-side session; only a hash of the cookie token is stored (migration 010).
model Session {
  id            String    @id @db.Uuid
  tokenHash     String    @unique
  csrfToken     String
  userId        String    @db.Uuid
  createdAt     DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  lastSeenAt    DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  expiresAt     DateTime  @db.Timestamptz(6)
  mfaVerifiedAt DateTime? @db.Timestamptz(6)
  revokedAt     DateTime? @db.Timestamptz(6)
  revokedReason String?
  ip            String?
  userAgent     String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

enum AuthTokenPurpose {
  INVITATION
  PASSWORD_RESET
}

// Single-use invitation / password-reset token, hashed (migration 010).
model AuthToken {
  id          String           @id @db.Uuid
  userId      String           @db.Uuid
  purpose     AuthTokenPurpose
  tokenHash   String           @unique
  expiresAt   DateTime         @db.Timestamptz(6)
  usedAt      DateTime?        @db.Timestamptz(6)
  createdById String           @db.Uuid
  createdAt   DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  user      User @relation("AuthTokenFor", fields: [userId], references: [id])
  createdBy User @relation("AuthTokenIssuedBy", fields: [createdById], references: [id])
}

// ─────────────────────────────────────────────
// Commission plans and closing (CDA)
// ─────────────────────────────────────────────

// An agent's standing plan. The split itself is per deal (TransactionAgent.splitPct);
// the plan supplies the annual cap and the fees charged on every deal.
model CommissionPlan {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  annualCap         Decimal? @db.Decimal(12, 2) // most the house collects per cap year; null = no cap
  capYearStartMonth Int      @default(1)
  capYearStartDay   Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User                @relation(fields: [userId], references: [id])
  fees CommissionPlanFee[]
}

// Charged to the agent on each deal, plus 13% HST (deal fee, desk fee, E&O …)
model CommissionPlanFee {
  id     String  @id @default(uuid()) @db.Uuid
  planId String  @db.Uuid
  name   String
  amount Decimal @db.Decimal(12, 2)

  plan CommissionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// The finalized closing for a deal: frozen numbers plus the exact CDA documents
// that were issued. Append-only (migration 005).
model ClosingStatement {
  id             String   @id @default(uuid()) @db.Uuid
  transactionId  String   @db.Uuid
  cdaNumber      String   @unique
  computation    Json // full calculation, as issued
  computationSha String // SHA-256 of the computation JSON
  lawyerHtml     String // CDA sent to the closing lawyer
  internalHtml   String // same, plus the agent commission statements
  idempotencyKey String   @unique @db.Uuid
  finalizedById  String   @db.Uuid
  finalizedAt    DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  revision     Int     @default(0) // 0 = first CDA; each reissue after a void adds one
  supersedesId String? @unique @db.Uuid

  transaction  Transaction          @relation(fields: [transactionId], references: [id])
  finalizedBy  User                 @relation("ClosingFinalizedBy", fields: [finalizedById], references: [id])
  payouts      ClosingAgentPayout[]
  payables     ClosingPayable[]
  receipts     CommissionReceipt[]
  void         ClosingVoid?
  supersedes   ClosingStatement?    @relation("Reissue", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy ClosingStatement?    @relation("Reissue")

  @@unique([transactionId, revision])
  @@index([transactionId])
}

// A finalized CDA withdrawn with a reason; its history stays (migration 009).
model ClosingVoid {
  closingId String   @id @db.Uuid
  reason    String
  actorId   String   @db.Uuid
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  closing ClosingStatement @relation(fields: [closingId], references: [id])
  actor   User             @relation(fields: [actorId], references: [id])
}

enum PayableType {
  COOP_BROKERAGE
  REFERRAL
}

// Commission owed to another brokerage (co-op not paid from trust, or a referral) (migration 009).
model ClosingPayable {
  id             String      @id @default(uuid()) @db.Uuid
  closingId      String      @db.Uuid
  payeeType      PayableType
  payeeName      String
  amount         Decimal     @db.Decimal(12, 2) // incl. HST
  hst            Decimal     @db.Decimal(12, 2)
  carriedForward Decimal     @default(0) @db.Decimal(12, 2)

  closing ClosingStatement @relation(fields: [closingId], references: [id])
  events  PayoutEvent[]

  @@index([closingId])
}

// One row per agent per finalized closing; also the source of cap year-to-date totals.
model ClosingAgentPayout {
  id               String   @id @default(uuid()) @db.Uuid
  closingId        String   @db.Uuid
  userId           String   @db.Uuid
  closeDate        DateTime @db.Date
  payeeName        String
  allocatedBaseGci Decimal  @db.Decimal(12, 2)
  houseSplitBase   Decimal  @db.Decimal(12, 2) // counts toward the agent's cap
  agentSplitBase   Decimal  @db.Decimal(12, 2)
  agentSplitHst    Decimal  @db.Decimal(12, 2)
  feesBase         Decimal  @db.Decimal(12, 2)
  feesHst          Decimal  @db.Decimal(12, 2)
  netPayout        Decimal  @db.Decimal(12, 2)
  wiredByLawyer    Decimal  @db.Decimal(12, 2) // always 0 since migration 006: payers never pay agents directly
  paidByBrokerage  Decimal  @db.Decimal(12, 2) // the whole payout, paid by the brokerage
  carriedForward   Decimal  @default(0) @db.Decimal(12, 2) // already paid under a voided CDA

  closing ClosingStatement @relation(fields: [closingId], references: [id])
  user    User             @relation(fields: [userId], references: [id])
  events  PayoutEvent[]

  @@index([userId, closeDate])
}

// Commission the brokerage actually received for a finalized closing. Append-only (migration 006).
model CommissionReceipt {
  id                 String   @id @default(uuid()) @db.Uuid
  closingId          String   @db.Uuid
  amount             Decimal  @db.Decimal(12, 2)
  receivedDate       DateTime @db.Date
  reference          String // bank reference for the incoming payment
  recordedById       String   @db.Uuid
  recordedAt         DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  trustAccountId     String?  @db.Uuid // a commission trust account, or
  operatingAccountId String?  @db.Uuid // the operating account

  closing          ClosingStatement           @relation(fields: [closingId], references: [id])
  recordedBy       User                       @relation(fields: [recordedById], references: [id])
  bankMatches      BankMatch[]
  reversal         CommissionReceiptReversal?
  trustAccount     TrustAccount?              @relation(fields: [trustAccountId], references: [id], onDelete: Restrict)
  operatingAccount OperatingAccount?          @relation(fields: [operatingAccountId], references: [id], onDelete: Restrict)

  @@index([closingId])
}

enum TaxAmountSource {
  CALCULATED
  RECORDED
  DERIVED_FROM_TOTAL
  MISSING
}

enum PayoutEventKind {
  APPROVED
  PAID
  PAYMENT_REVERSED
  CANCELLED
}

// A recalled or bounced commission payment (migration 009).
model CommissionReceiptReversal {
  receiptId    String   @id @db.Uuid
  reason       String
  reversedDate DateTime @db.Date
  reference    String?
  actorId      String   @db.Uuid
  createdAt    DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  receipt     CommissionReceipt @relation(fields: [receiptId], references: [id])
  actor       User              @relation(fields: [actorId], references: [id])
  bankMatches BankMatch[]
}

// The history of an agent payout or third-party payable: APPROVED → PAID → PAYMENT_REVERSED → PAID …,
// or CANCELLED. Append-only; the last event is the current state (migrations 006, 009).
model PayoutEvent {
  id                        String          @id @default(uuid()) @db.Uuid
  payoutId                  String?         @db.Uuid
  kind                      PayoutEventKind
  actorId                   String          @db.Uuid
  eventDate                 DateTime        @db.Date
  reference                 String? // payment reference, required for PAID
  note                      String?
  createdAt                 DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  payableId                 String?         @db.Uuid
  seq                       Int
  amount                    Decimal?        @db.Decimal(12, 2)
  payFromTrustAccountId     String?         @db.Uuid
  payFromOperatingAccountId String?         @db.Uuid
  balanceStatementId        String?         @db.Uuid // the verified bank balance the approval relied on
  segregationException      Boolean         @default(false)
  exceptionReason           String?

  payout           ClosingAgentPayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  payable          ClosingPayable?     @relation(fields: [payableId], references: [id], onDelete: Restrict)
  actor            User                @relation(fields: [actorId], references: [id])
  payFromTrust     TrustAccount?       @relation(fields: [payFromTrustAccountId], references: [id], onDelete: Restrict)
  payFromOperating OperatingAccount?   @relation(fields: [payFromOperatingAccountId], references: [id], onDelete: Restrict)
  balanceStatement BankStatement?      @relation(fields: [balanceStatementId], references: [id], onDelete: Restrict)
  bankMatches      BankMatch[]

  @@unique([payoutId, seq])
  @@unique([payableId, seq])
}

// How long each kind of record is kept, and why (migration 011). Disposal is manual and approved.
model RetentionRule {
  recordType     String   @id
  description    String
  retentionYears Int
  startsFrom     String
  legalBasis     String
  effectiveFrom  DateTime @db.Date
}

// Records that must not be disposed of (migration 011). transactionId null = brokerage-wide.
model LegalHold {
  id            String    @id @db.Uuid
  transactionId String?   @db.Uuid
  reason        String
  placedById    String    @db.Uuid
  placedAt      DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  releasedById  String?   @db.Uuid
  releasedAt    DateTime? @db.Timestamptz(6)
  releaseNote   String?

  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  placedBy    User         @relation("LegalHoldPlacedBy", fields: [placedById], references: [id])
  releasedBy  User?        @relation("LegalHoldReleasedBy", fields: [releasedById], references: [id], onDelete: Restrict)
}

enum BreachEventKind {
  NOTE
  CONTAINED
  RISK_ASSESSED
  OPC_REPORTED
  INDIVIDUALS_NOTIFIED
  ORGANIZATIONS_NOTIFIED
  CLOSED
}

// PIPEDA breach of security safeguards record (migration 011).
model PrivacyBreach {
  id                  String    @id @db.Uuid
  discoveredAt        DateTime  @db.Timestamptz(6)
  occurredFrom        DateTime? @db.Date
  occurredTo          DateTime? @db.Date
  description         String
  informationInvolved String
  individualsAffected Int?
  recordedById        String    @db.Uuid
  recordedAt          DateTime  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  recordedBy User                 @relation(fields: [recordedById], references: [id])
  events     PrivacyBreachEvent[]
}

model PrivacyBreachEvent {
  id                        String          @id @db.Uuid
  breachId                  String          @db.Uuid
  kind                      BreachEventKind
  eventDate                 DateTime        @db.Date
  realRiskOfSignificantHarm Boolean?
  reference                 String?
  note                      String
  actorId                   String          @db.Uuid
  createdAt                 DateTime        @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  breach PrivacyBreach @relation(fields: [breachId], references: [id])
  actor  User          @relation(fields: [actorId], references: [id])

  @@index([breachId])
}

// Days proclaimed as public holidays (Legislation Act s.87), with the proclamation (migration 012).
// Statutory holidays are generated in code; see backend/src/lib/ontario-calendar.ts.
model ProclaimedHoliday {
  date      DateTime @id @db.Date
  name      String
  reference String
  addedById String   @db.Uuid
  addedAt   DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  addedBy User @relation(fields: [addedById], references: [id])
}

enum UnclaimedEntitlement {
  ENTITLED_PARTY_NOT_LOCATED
  ENTITLEMENT_UNCLEAR
  DISPUTED
}

enum UnclaimedEventKind {
  CONTACT_ATTEMPT
  NOTE
  INTEREST_ACCRUED
  ENTITLEMENT_CHANGED
  PARTY_LOCATED
  RESOLVED_PAID_OUT
  REMITTED_TO_RECO
  CLOSED
}

// Trust money whose owner can't be found or whose entitlement is unclear (TRESA s.27(4); RECO Bulletin 8.1, migration 012).
// Append-only; remitting to RECO is a policy-gated record of a payment made outside this system.
model UnclaimedTrustFund {
  id             String               @id @default(uuid()) @db.Uuid
  transactionId  String               @db.Uuid
  trustAccountId String               @db.Uuid
  amount         Decimal              @db.Decimal(14, 2)
  heldSince      DateTime             @db.Date
  entitledSince  DateTime?            @db.Date
  entitlement    UnclaimedEntitlement
  entitledParty  String?
  reason         String
  openedById     String               @db.Uuid
  openedAt       DateTime             @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  transaction  Transaction          @relation(fields: [transactionId], references: [id])
  trustAccount TrustAccount         @relation(fields: [trustAccountId], references: [id])
  openedBy     User                 @relation(fields: [openedById], references: [id])
  events       UnclaimedFundEvent[]

  @@unique([transactionId, trustAccountId])
}

model UnclaimedFundEvent {
  id             String                @id @default(uuid()) @db.Uuid
  fundId         String                @db.Uuid
  kind           UnclaimedEventKind
  eventDate      DateTime              @db.Date
  method         String? // contact attempts: letter, email, phone, skip trace
  outcome        String?
  entitlement    UnclaimedEntitlement?
  amount         Decimal?              @db.Decimal(14, 2)
  reference      String?
  note           String
  documentFileId String?               @db.Uuid
  actorId        String                @db.Uuid
  createdAt      DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)

  fund         UnclaimedTrustFund @relation(fields: [fundId], references: [id])
  documentFile DocumentFile?      @relation(fields: [documentFileId], references: [id], onDelete: Restrict)
  actor        User               @relation(fields: [actorId], references: [id])

  @@index([fundId])
}
