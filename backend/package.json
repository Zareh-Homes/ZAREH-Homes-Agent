{
  "name": "zareh-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zareh Homes back office API",
  "engines": {
    "node": ">=22.18"
  },
  "prisma": {
    "schema": "../brokerage-db/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node src/server.ts",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.4.0",
    "@prisma/client": "6.19.3",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.10.0",
    "prisma": "6.19.3",
    "typescript": "5.6.3"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
